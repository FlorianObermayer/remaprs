{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "build (release)",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--release"],
      "problemMatcher": [],
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "cargo",
      "args": ["test"],
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "check (fmt, clippy, test, deny, release)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/check.ps1"],
      "problemMatcher": [],
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "check (fast)",
      "detail": "Same gates as CI without the release build; use this while editing.",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/check.ps1", "-Fast"],
      "problemMatcher": [],
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "bump version (patch)",
      "detail": "0.1.0 -> 0.1.1. Rewrites Cargo.toml and Cargo.lock, then stops: committing and pushing to master is what publishes the release.",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/bump-version.ps1", "patch"],
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "reveal": "always"
      }
    },
    {
      "label": "bump version (minor)",
      "detail": "0.1.0 -> 0.2.0. See \"bump version (patch)\" for what happens next.",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/bump-version.ps1", "minor"],
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "reveal": "always"
      }
    },
    {
      "label": "bump version (dry run)",
      "detail": "Prints the version change without writing Cargo.toml or Cargo.lock.",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/bump-version.ps1", "-DryRun"],
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "reveal": "always"
      }
    },
    {
      "label": "build release zip",
      "detail": "Packages target\\release\\remaprs.exe and the docs into dist\\, printing the SHA256.",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/release.ps1"],
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "reveal": "always"
      }
    },
    {
      "label": "preview release notes",
      "detail": "Renders the notes git-cliff would publish, into release-body.md. Needs git-cliff on PATH.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/release-notes.ps1",
        "-Version",
        "0.1.0",
        "-Build",
        "0.1.0-local",
        "-Kind",
        "stable",
        "-OutputPath",
        "${workspaceFolder}/release-body.md"
      ],
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "reveal": "always"
      }
    },
    {
      "label": "start",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--",
        "--config",
        "examples/remaprs.yaml"
      ],
      "problemMatcher": [],
      "dependsOn": "build (release)",
      "presentation": {
        "clear": true,
        "reveal": "always"
      }
    },
    {
      "label": "start (dry run)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--",
        "--config",
        "examples/remaprs.yaml",
        "--dry-run"
      ],
      "problemMatcher": [],
      "dependsOn": "build (release)",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "start (list buttons)",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--release", "--", "--list-buttons"],
      "problemMatcher": [],
      "dependsOn": "build (release)",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "start (logged)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--",
        "--config",
        "examples/remaprs.yaml",
        "--log-file",
        "remaprs.log"
      ],
      "problemMatcher": [],
      "dependsOn": "build (release)",
      "presentation": {
        "clear": true,
        "reveal": "always"
      }
    },
    {
      "label": "config check (example)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--",
        "config",
        "check",
        "-c",
        "examples/remaprs.yaml"
      ],
      "problemMatcher": [],
      "dependsOn": "build (release)",
      "presentation": {
        "clear": true,
        "reveal": "always"
      }
    }
  ]
}
